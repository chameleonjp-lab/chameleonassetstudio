{
  "name": "chameleonassetstudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && vite build --config tools/h3/vite.config.ts",
    "build:app": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=chromium",
    "e2e:webkit": "playwright test --config playwright.webkit.config.ts",
    "e2e:quality": "playwright test --config playwright.production.config.ts",
    "test:ci-scope": "node --test tools/ci/*.test.mjs",
    "measure:h3:node": "vite-node tools/h3/measure-node.ts",
    "measure:h3:build": "tsc --noEmit && vite build --config tools/h3/vite.config.ts",
    "measure:h3:serve": "vite --config tools/h3/vite.config.ts",
    "measure:h3:preview": "vite preview --config tools/h3/vite.config.ts",
    "measure:h3:chromium": "playwright test --config tools/h3/playwright.config.ts",
    "pages:assemble": "node tools/pages/assemble.mjs",
    "pages:preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "pages:chromium": "playwright test --config tools/pages/playwright.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "evidence:group18": "node tools/evidence/write-group18-record.mjs",
    "evidence:group22": "node tools/evidence/write-group22-record.mjs",
    "consumer:build": "vite build --config tools/3d-consumer/vite.config.ts",
    "consumer:serve": "vite --config tools/3d-consumer/vite.config.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fflate": "^0.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@babylonjs/core": "9.28.0",
    "@babylonjs/loaders": "9.28.0",
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.53.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.5.0",
    "babylonjs-gltf2interface": "9.28.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.2.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@types/three": {
      "@types/webxr": "0.5.24",
      "@types/stats.js": "0.17.4",
      "meshoptimizer": "1.1.1",
      "@tweenjs/tween.js": "23.1.3",
      "@dimforge/rapier3d-compat": "0.12.0",
      "fflate": "0.8.3"
    }
  }
}
